<?xml version="1.0" encoding="utf-8"?>
<!-- Cercul butonului ↻ din widget. La apasare se umple, ca degetul sa stie ca a nimerit. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/card" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</selector>
