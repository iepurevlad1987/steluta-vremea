<?xml version="1.0" encoding="utf-8"?>
<!-- Fundalul widget-ului, cu colturi rotunjite ca ale celorlalte widget-uri din Android 12
     incoace. **Opac dinadins**: culoarea si transparenta le pune WidgetTheme din cod, iar
     un fundal deja semi-transparent aici ar face ca nicio tema sa nu poata fi opaca. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_widget_solid" />
    <corners android:radius="24dp" />
</shape>
