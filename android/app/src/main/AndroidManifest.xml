<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Locatia, doar cat e aplicatia deschisa. **`ACCESS_BACKGROUND_LOCATION` lipseste
        dinadins**: widget-ul nu cauta singur unde esti, foloseste ce s-a salvat ultima
        data cand ai cerut tu - din aplicatie sau cu butonul ↻ din widget. Asa nu trebuie ceruta permisiunea „Permite tot
        timpul", pe care Android o ingroapa in doua ecrane si o poate revoca singura.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        Pentru butonul ↻ din widget, care porneste RefreshService: un serviciu in prim-plan
        e felul prin care o apasare pe widget poate folosi permisiunea „cat folosesc
        aplicatia". Ultima e ceruta separat de Android 14 incolo, pe tip de serviciu.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Steluta">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Ce face butonul ↻ din widget. `location` cand are voie la locatie;
            `shortService` e rezerva de pe Android 14+, cand n-are - vezi goForeground().
            Nu e `exported`: il porneste doar widget-ul, adica aplicatia insasi.
        -->
        <service
            android:name=".RefreshService"
            android:exported="false"
            android:foregroundServiceType="location|shortService" />

        <!--
            Widget-ul. `exported="true"` e obligatoriu: cine il aseaza pe ecranul de start
            e launcher-ul, adica alta aplicatie.

            Al doilea `action` e al nostru, din 1.0, cand tot widget-ul era buton de
            reimprospatare. Ramane pentru widget-urile asezate inainte de actualizare.
        -->
        <receiver
            android:name=".StelutaWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="ro.iepur.steluta.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

    </application>
</manifest>
