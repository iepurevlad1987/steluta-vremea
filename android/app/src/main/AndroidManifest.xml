<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Locatia, doar cat e aplicatia deschisa. **`ACCESS_BACKGROUND_LOCATION` lipseste
        dinadins**: widget-ul nu cauta singur unde esti, foloseste ce s-a salvat ultima
        data cand ai deschis aplicatia. Asa nu trebuie ceruta permisiunea „Permite tot
        timpul", pe care Android o ingroapa in doua ecrane si o poate revoca singura.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Steluta">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Widget-ul. `exported="true"` e obligatoriu: cine il aseaza pe ecranul de start
            e launcher-ul, adica alta aplicatie.

            Al doilea `action` e al nostru, pentru tap-ul de reimprospatare - Android nu
            livreaza actiuni proprii unui receiver daca nu sunt declarate aici.
        -->
        <receiver
            android:name=".StelutaWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="ro.iepur.steluta.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

    </application>
</manifest>
